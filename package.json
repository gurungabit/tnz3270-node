{
  "name": "tnz3270-node",
  "version": "0.1.1",
  "author": "Abit Gurung <gurungabit@gmail.com>",
  "keywords": [
    "tn3270",
    "3270",
    "mainframe",
    "terminal",
    "emulator",
    "automation",
    "ibm",
    "z/os",
    "mvs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurungabit/tnz3270-node.git"
  },
  "bugs": {
    "url": "https://github.com/gurungabit/tnz3270-node/issues"
  },
  "homepage": "https://github.com/gurungabit/tnz3270-node#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.10.2",
    "bunchee": "^6.9.4",
    "tsdx": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "description": "TypeScript library for IBM mainframe TN3270 terminal automation",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsdx dev",
    "build": "tsdx build",
    "test": "tsdx test",
    "test:watch": "tsdx test --watch",
    "lint": "tsdx lint",
    "format": "tsdx format",
    "format:check": "tsdx format --check",
    "typecheck": "tsdx typecheck",
    "prepublishOnly": "bun run build",
    "release": "bash scripts/release.sh"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
